# Copy to .env and edit. .env is ignored by git: never commit it.
# Nothing here is needed for the free feeds (Deriv, Bybit, Binance).

# Ports (the hub always binds to 127.0.0.1)
HUB_HTTP_PORT=8770
HUB_WS_PORT=8765

# --- Local MT5: a MetaTrader 5 terminal on this Windows PC (pip install MetaTrader5) ---
LOCAL_MT5=0
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Remote MT5: bridge/mt5_bridge.py on a VPS, reached through an SSH tunnel ---
# An alias from your ~/.ssh/config (key login, no password prompt). Empty = off.
REMOTE_MT5_SSH_HOST=
REMOTE_MT5_BRIDGE_PORT=8797
# Optional command on the server, run by the Restart chart button with the argument "bridge" or "full".
REMOTE_MT5_RESTART_CMD=

# --- Log panel: extra local log files to show, name=path;name2=path2 ---
HUB_TAIL_FILES=
