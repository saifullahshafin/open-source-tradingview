# Copy to .env and edit. .env is ignored by git: never commit it.
# Nothing here is needed for the free feeds (Deriv, Bybit, Binance).

# Ports (the hub always binds to 127.0.0.1)
HUB_HTTP_PORT=8770
HUB_WS_PORT=8765

# --- Outbound proxy: when Bybit/Binance/OKX/... are blocked without a VPN ---
# HTTP or SOCKS local client (Clash / V2Ray / etc). Leave empty to go direct.
# HUB_PROXY=http://127.0.0.1:2080
# (also accepts HTTP_PROXY / HTTPS_PROXY; localhost is always excluded via NO_PROXY)

# --- Local MT5: a MetaTrader 5 terminal on this Windows PC (pip install MetaTrader5) ---
LOCAL_MT5=0
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_PORTABLE=1   (terminal data inside its own folder; set by the installer)
# LOCAL_MT5_LABEL=Local MT5   (broker name shown in the app)

# --- Remote MT5: bridge/mt5_bridge.py on a VPS, reached through an SSH tunnel ---
# An alias from your ~/.ssh/config (key login, no password prompt). Empty = off.
REMOTE_MT5_SSH_HOST=
REMOTE_MT5_BRIDGE_PORT=8797
# Optional command on the server, run by the Restart chart button with the argument "bridge" or "full".
REMOTE_MT5_RESTART_CMD=
# Ticker prefix and broker name in the app. Saved layouts keep the prefix, so change it only on a fresh install.
# REMOTE_MT5_PREFIX=RMT_
# REMOTE_MT5_LABEL=Remote MT5
# REMOTE_MT5_SHORT=RMT
# More server ports to carry through the same tunnel, comma separated (for your own add-ons).
# REMOTE_MT5_EXTRA_PORTS=
# 0 = another program already holds the tunnel: use it, never start or close it.
# REMOTE_MT5_TUNNEL=1

# --- Log panel: extra local log files to show, name=path;name2=path2 ---
HUB_TAIL_FILES=

# --- Testing: 0 = ignore the private/ folder and run as a plain install ---
# TRADEX_PRIVATE=1
